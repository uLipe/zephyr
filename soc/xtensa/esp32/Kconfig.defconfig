if SOC_ESP32

config SOC
	default "esp32"

config IRQ_OFFLOAD_INTNUM
	default 7

config SMP
	default y

if SMP

config SCHED_IPI_SUPPORTED
	default y

config MP_NUM_CPUS
	default 2

endif

config MINIMAL_LIBC_OPTIMIZE_STRING_FOR_SIZE
	default n

config LOG_DETECT_MISSED_STRDUP
	default n

endif
