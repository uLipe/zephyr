config ST_GPU2D
	bool "STM32 GPU2D graphics accelerator bring-up driver"
	default y
	depends on DT_HAS_ST_STM32_GPU2D_ENABLED
	help
		This option enables the GPU2D graphics accelerator bring-up
		code, it makes the GPU ready to be consumed by compatible
		specifications drivers like NemaGFX.
